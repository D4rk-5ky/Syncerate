# Syncerate private configuration
*.cfg
*.conf
config/sourcelist*
config/destlist*

# Keep example configurations
!*.example.cfg
!*.example.conf
!config/example-Syncerate.cfg

# Runtime logs and output
*.log
*.err
*.out

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build and packaging caches
build/
dist/
*.egg-info/

# Temporary files
*.tmp
*.temp
*~

# Local editor files
.vscode/
.idea/
