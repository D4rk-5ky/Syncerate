# Syncerate private configuration
*.cfg
*.conf
config/sourcelist*
config/destlist*
config/*.toml

# Keep example configurations
!*.example.cfg
!*.example.conf
!config/example-Syncerate.toml

# Runtime logs and output
*.log
*.err
*.out

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build and packaging caches
.build/
build/
*.egg-info/

# dist/ is delivery-only: keep its README, ignore generated binaries/output.
dist/*
!dist/README.md

# Temporary files
*.tmp
*.temp
*~

# Local editor files
.vscode/
.idea/

# Kernel-backed per-TOML safelock files; never remove while running
*.toml.lock
